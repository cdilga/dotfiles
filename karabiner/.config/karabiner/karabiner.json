      "complex_modifications": {
        "rules": [
          {
            "description": "Caps Lock = Super (variable; never locks)",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "caps_lock"
                },
                "to": [
                  {
                    "set_variable": {
                      "name": "super",
                      "value": 1
                    }
                  }
                ],
                "to_after_key_up": [
                  {
                    "set_variable": {
                      "name": "super",
                      "value": 0
                    }
                  }
                ]
              }
            ]
          },
          {
            "description": "Super+Shift+H warp west",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "h",
                  "modifiers": {
                    "mandatory": [
                      "shift"
                    ]
                  }
                },
                "to": [
                  {
                    "shell_command": "/opt/homebrew/bin/yabai -m window --warp west"
                  }
                ],
                "conditions": [
                  {
                    "type": "variable_if",
